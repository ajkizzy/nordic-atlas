# ── Supabase (create free project at supabase.com, then Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — ONLY used by scripts/seed-leads.mjs, never shipped to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional lead-seeding sources ──
# Danish CVR register (Erhvervsstyrelsen system-til-system access)
CVR_API_USER=
CVR_API_PASS=
# Google Maps Places API (optional alternative seeding source)
GOOGLE_PLACES_API_KEY=
